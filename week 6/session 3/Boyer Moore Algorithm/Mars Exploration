import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        sc.close();

        int changes = 0;
        String expected = "SOS";
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) != expected.charAt(i % 3)) {
                changes++;
            }
        }
        System.out.println(changes);
    }
}
